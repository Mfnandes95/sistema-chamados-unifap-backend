UNIFAP_AMBIENTE=desenvolvimento
UNIFAP_JWT_SECRET=troque-esta-chave-por-um-segredo-com-32-ou-mais-caracteres
UNIFAP_JWT_ALGORITHM=HS256
UNIFAP_JWT_AUDIENCE=unifap-chamados-api
UNIFAP_JWT_EXPIRE_MINUTES=60
UNIFAP_LOGIN_MAX_TENTATIVAS_CONTA=5
UNIFAP_LOGIN_MAX_TENTATIVAS_IP=20
UNIFAP_LOGIN_JANELA_MINUTOS=15
UNIFAP_CONFIAR_PROXY_HEADERS=false
UNIFAP_PERMITIR_SENHA_DEMO=true
UNIFAP_CORS_ORIGINS=["http://localhost:5173"]
UNIFAP_MAX_CORPO_BYTES=1048576
UNIFAP_UPLOAD_DIR=./uploads
UNIFAP_MAX_UPLOAD_BYTES=20971520
UNIFAP_MAX_EVIDENCIAS_POR_CHAMADO=10
UNIFAP_PRAZO_REABERTURA_DIAS=7
UNIFAP_MAX_REABERTURAS=3
UNIFAP_INTERVALO_MANUTENCAO_SEGUNDOS=300
# Opcional: quando definidos, ativa os adaptadores de persistência Supabase
# UNIFAP_SUPABASE_URL=https://<project-ref>.supabase.co
# UNIFAP_SUPABASE_KEY=sb_publishable_...
# UNIFAP_SUPABASE_SECRET_KEY=sb_secret_...
#
# Checklist mínimo para produção (ex.: Railway):
# UNIFAP_AMBIENTE=producao
# UNIFAP_JWT_SECRET=<segredo-aleatorio-32+-caracteres>
# UNIFAP_PERMITIR_SENHA_DEMO=false
# UNIFAP_CONFIAR_PROXY_HEADERS=true
# UNIFAP_CORS_ORIGINS=["https://<seu-servico>.up.railway.app"]
